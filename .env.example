# Server-only: used by drizzle-kit for migrations. NEVER prefix with EXPO_PUBLIC_.
# Supabase dashboard -> Connect -> "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Safe to ship in the app bundle (protected by row level security).
# Supabase dashboard -> Project Settings -> API Keys -> Publishable key. NEVER put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin key: bypasses row level security. NEVER prefix with EXPO_PUBLIC_ or import it in app code.
# Supabase dashboard -> Project Settings -> API Keys -> Secret key. Only for seed scripts, API routes, Edge Functions.
SUPABASE_SECRET_KEY=
